@prefix : <http://www.semanticweb.org/int-act-project/8/mh-ontology-30#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/int-act-project/8/mh-ontology-30#> .

<http://www.semanticweb.org/int-act-project/8/mh-ontology-30> rdf:type owl:Ontology ;
                                                               owl:versionIRI <http://www.semanticweb.org/int-act-project/8/mh-ontology-30> ;
                                                               <http://purl.org/dc/terms/creator> "INT-ACT UÉvora Team" ;
                                                               <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
                                                               <http://purl.org/dc/terms/title> "Megalithic Heritage Ontology" ;
                                                               rdfs:comment "A CIDOC-CRM based ontology for representing megalithic and natural heritage sites, developed by the INT-ACT team" ;
                                                               owl:versionInfo 1.0 .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/language
<http://purl.org/dc/terms/language> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P129_isAbout
:P129_isAbout rdf:type owl:ObjectProperty ;
              rdfs:domain :E89_Propositional_Object ;
              rdfs:range :E1_CRM_Entity .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P130_shows_features_of
:P130_shows_features_of rdf:type owl:ObjectProperty ;
                        rdfs:domain :E70_Thing ;
                        rdfs:range :E70_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P14_carriedOutBy
:P14_carriedOutBy rdf:type owl:ObjectProperty ;
                  rdfs:domain :E7_Activity ;
                  rdfs:range :E39_Actor .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P165_incorporates
:P165_incorporates rdf:type owl:ObjectProperty ;
                   rdfs:domain :E89_Propositional_Object ;
                   rdfs:range :E90_Symbolic_Object .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P198_holds_or_supports
:P198_holds_or_supports rdf:type owl:ObjectProperty ;
                        rdfs:domain :E18_Physical_Thing ;
                        rdfs:range :E18_Physical_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P46_IsComposedOf
:P46_IsComposedOf rdf:type owl:ObjectProperty ;
                  rdfs:domain :E18_Physical_Thing ;
                  rdfs:range :E18_Physical_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P4_hasTimeSpan
:P4_hasTimeSpan rdf:type owl:ObjectProperty ;
                rdfs:domain :E2_Temporal_Entity ;
                rdfs:range :E52_TimeSpan .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P53_has_former_or_current_location
:P53_has_former_or_current_location rdf:type owl:ObjectProperty ;
                                    rdfs:domain :E18_Physical_Thing ;
                                    rdfs:range :E53_Place .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P89_falls_within
:P89_falls_within rdf:type owl:ObjectProperty ;
                  rdfs:domain :E53_Place ;
                  rdfs:range :E53_Place .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P8_took_place_on_or_within
:P8_took_place_on_or_within rdf:type owl:ObjectProperty ;
                            rdfs:domain :E4_Period ;
                            rdfs:range :E18_Physical_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasClimate
:hasClimate rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :P130_shows_features_of ;
            rdfs:domain :E53_Place ;
            rdfs:range :Climate .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasConstructionTimeSpan
:hasConstructionTimeSpan rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :P4_hasTimeSpan ;
                         rdfs:domain :Construction ;
                         rdfs:range :E52_TimeSpan .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasEngravings
:hasEngravings rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :P130_shows_features_of ;
               rdfs:domain :Menhir ;
               rdfs:range :Engravings .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasExcavationTimeSpan
:hasExcavationTimeSpan rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :P4_hasTimeSpan ;
                       rdfs:domain :Excavation ;
                       rdfs:range :E52_TimeSpan .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasIdentificationTimeSpan
:hasIdentificationTimeSpan rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :P4_hasTimeSpan ;
                           rdfs:domain :Identification .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasMegalithicComponents
:hasMegalithicComponents rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :P46_IsComposedOf ;
                         rdfs:domain :MegalithicMonument ;
                         rdfs:range :Menhir .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasTypicalLandscape
:hasTypicalLandscape rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :P130_shows_features_of ;
                     rdfs:domain :E53_Place ;
                     rdfs:range :Landscape .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasUsageTimeSpan
:hasUsageTimeSpan rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :P4_hasTimeSpan ;
                  rdfs:domain :OcupationOrUsage ;
                  rdfs:range :E52_TimeSpan .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Link
:Link rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :Audio ,
                  :Image ,
                  :Video ,
                  <http://www.semanticweb.org/int-act-project/8/mh-ontology-30#3DModel> ;
      rdfs:range xsd:anyURI .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#format
:format rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :MegalithicMonument ;
        rdfs:range xsd:string .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#heightMeters
:heightMeters rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :Menhir ;
              rdfs:range xsd:decimal .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#rockType
:rockType rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :MegalithicMonument ;
          rdfs:range xsd:string .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#usagetypeArtefacts
:usagetypeArtefacts rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain :ArchaeologicalArtefact ;
                    rdfs:range xsd:string .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#usagetypeMegalithism
:usagetypeMegalithism rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain :MegalithicSite ;
                      rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalArtefact
:ArchaeologicalArtefact rdf:type owl:Class ;
                        rdfs:subClassOf :E24_Physical_Human-Made_Thing ;
                        rdfs:comment "Artefact found in an archaeological site" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalMonument
:ArchaeologicalMonument rdf:type owl:Class ;
                        rdfs:subClassOf :CulturalHeritageMonument ;
                        rdfs:comment "A monument that preserves traces of human occupation" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalSite
:ArchaeologicalSite rdf:type owl:Class ;
                    rdfs:subClassOf :E27_Site ;
                    rdfs:comment "The area where traces of human occupation have been found" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Archaeologist
:Archaeologist rdf:type owl:Class ;
               rdfs:subClassOf :E21_Person ;
               rdfs:comment "A professional whose expertise involves both on-site and off-site study of past human societies" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Arrowhead
:Arrowhead rdf:type owl:Class ;
           rdfs:subClassOf :ArchaeologicalArtefact ;
           rdfs:comment "The tip of an arrow" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Audio
:Audio rdf:type owl:Class ;
       rdfs:subClassOf :E31_Document ;
       rdfs:comment "Audio files" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Beaker
:Beaker rdf:type owl:Class ;
        rdfs:subClassOf :ArchaeologicalArtefact ;
        rdfs:comment "A ceramic drinking or storage vessel typical of Late Neolithic/Bronze Age" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#BirdSounds
:BirdSounds rdf:type owl:Class ;
            rdfs:subClassOf :NaturalSoundscape ;
            rdfs:comment "Sounds of birds chirping" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#BronzeAge
:BronzeAge rdf:type owl:Class ;
           rdfs:subClassOf :E4_Period ;
           owl:disjointWith :Neolithic ;
           rdfs:comment "A specific and transitional period between prehistory and protohistory" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Climate
:Climate rdf:type owl:Class ;
         rdfs:subClassOf :E26_Physical_Feature ;
         rdfs:comment "A feature regarding weather conditions" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Construction
:Construction rdf:type owl:Class ;
              rdfs:subClassOf :E7_Activity ;
              rdfs:comment "The construction of the archaeological site" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Coordinates
:Coordinates rdf:type owl:Class ;
             rdfs:subClassOf :E94_Space_Primitive ;
             rdfs:comment "A specific location in space" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#CulturalHeritageMonument
:CulturalHeritageMonument rdf:type owl:Class ;
                          rdfs:subClassOf :E24_Physical_Human-Made_Thing ;
                          rdfs:comment "A heritage monument related to a nation or a group of people" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#CulturalHeritageSite
:CulturalHeritageSite rdf:type owl:Class ;
                      rdfs:subClassOf :E27_Site ;
                      rdfs:comment "A place of importance recognised for its historical and cultural value" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#CulturalLandscape
:CulturalLandscape rdf:type owl:Class ;
                   rdfs:subClassOf :Landscape ;
                   rdfs:comment "A landscape containing features made by humans. It can be protected as a cultural heritage site" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#District
:District rdf:type owl:Class ;
          rdfs:subClassOf :E53_Place ;
          rdfs:comment "A subdivision of a region that can encompass multiple municipalities within boundaries" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E18_Physical_Thing
:E18_Physical_Thing rdf:type owl:Class ;
                    rdfs:subClassOf :E70_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E1_CRM_Entity
:E1_CRM_Entity rdf:type owl:Class .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E21_Person
:E21_Person rdf:type owl:Class ;
            rdfs:subClassOf :E39_Actor .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E24_Physical_Human-Made_Thing
:E24_Physical_Human-Made_Thing rdf:type owl:Class ;
                               rdfs:subClassOf :E18_Physical_Thing ,
                                               :E71_Human-Made_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E26_Physical_Feature
:E26_Physical_Feature rdf:type owl:Class ;
                      rdfs:subClassOf :E18_Physical_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E27_Site
:E27_Site rdf:type owl:Class ;
          rdfs:subClassOf :E26_Physical_Feature .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E2_Temporal_Entity
:E2_Temporal_Entity rdf:type owl:Class ;
                    rdfs:subClassOf :E1_CRM_Entity .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E31_Document
:E31_Document rdf:type owl:Class ;
              rdfs:subClassOf :E73_Information_Object .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E33_Linguistic_Object
:E33_Linguistic_Object rdf:type owl:Class ;
                       rdfs:subClassOf :E73_Information_Object .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E39_Actor
:E39_Actor rdf:type owl:Class ;
           rdfs:subClassOf :E1_CRM_Entity .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E4_Period
:E4_Period rdf:type owl:Class ;
           rdfs:subClassOf :E2_Temporal_Entity .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E52_TimeSpan
:E52_TimeSpan rdf:type owl:Class ;
              rdfs:subClassOf :E1_CRM_Entity .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E53_Place
:E53_Place rdf:type owl:Class ;
           rdfs:subClassOf :E1_CRM_Entity .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E70_Thing
:E70_Thing rdf:type owl:Class ;
           rdfs:subClassOf :E1_CRM_Entity .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E71_Human-Made_Thing
:E71_Human-Made_Thing rdf:type owl:Class ;
                      rdfs:subClassOf :E70_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E73_Information_Object
:E73_Information_Object rdf:type owl:Class ;
                        rdfs:subClassOf :E90_Symbolic_Object .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E74_Group
:E74_Group rdf:type owl:Class ;
           rdfs:subClassOf :E39_Actor .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E7_Activity
:E7_Activity rdf:type owl:Class ;
             rdfs:subClassOf :E4_Period .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E89_Propositional_Object
:E89_Propositional_Object rdf:type owl:Class ;
                          rdfs:subClassOf :E71_Human-Made_Thing .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E90_Symbolic_Object
:E90_Symbolic_Object rdf:type owl:Class ;
                     rdfs:subClassOf :E89_Propositional_Object .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E94_Space_Primitive
:E94_Space_Primitive rdf:type owl:Class ;
                     rdfs:subClassOf :E1_CRM_Entity .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#EarlyNeolithic
:EarlyNeolithic rdf:type owl:Class ;
                rdfs:subClassOf :Neolithic ;
                rdfs:comment "The earliest phase of the Neolithic" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Engravings
:Engravings rdf:type owl:Class ;
            rdfs:subClassOf :E90_Symbolic_Object ;
            rdfs:comment "Carved marks or decorations on menhirs" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Excavation
:Excavation rdf:type owl:Class ;
            rdfs:subClassOf :E7_Activity ;
            rdfs:comment "Technical examination of an archaeological site which involves the digging and removal of layers of earth and their associated artefacts" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#FoodVessel
:FoodVessel rdf:type owl:Class ;
            rdfs:subClassOf :Beaker ;
            rdfs:comment "A subtype of Beaker, typically larger and used in funerary contexts" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#GroovedWare
:GroovedWare rdf:type owl:Class ;
             rdfs:subClassOf :ArchaeologicalArtefact ;
             rdfs:comment "Neolithic ceramic tradition characterized by incised decoration" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Identification
:Identification rdf:type owl:Class ;
                rdfs:subClassOf :E7_Activity ;
                rdfs:comment "The identification of the archaeological site" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Idol
:Idol rdf:type owl:Class ;
      rdfs:subClassOf :ArchaeologicalArtefact ;
      rdfs:comment "Object made with the purpose of fulfilling a religious / ritualistic / symbolic goal" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Image
:Image rdf:type owl:Class ;
       rdfs:subClassOf :E31_Document ;
       rdfs:comment "Image files" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Landscape
:Landscape rdf:type owl:Class ;
           rdfs:subClassOf :E26_Physical_Feature ;
           rdfs:comment "Landscape includes physical and natural elements of an environment, as well as human elements such as built structures" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#LateNeolithic
:LateNeolithic rdf:type owl:Class ;
               rdfs:subClassOf :Neolithic ;
               rdfs:comment "The latest phase of the Neolithic" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#LithicTool
:LithicTool rdf:type owl:Class ;
            rdfs:subClassOf :StoneTool ;
            rdfs:comment "Tool made by knapping stone such as flint, quartz or mylonite" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#LoomWeight
:LoomWeight rdf:type owl:Class ;
            rdfs:subClassOf :ArchaeologicalArtefact ;
            rdfs:comment "Object used in textile production" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#MegalithicMonument
:MegalithicMonument rdf:type owl:Class ;
                    rdfs:subClassOf :ArchaeologicalMonument ;
                    rdfs:comment "An archaeological monument built with standing megalithic stones" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#MegalithicSite
:MegalithicSite rdf:type owl:Class ;
                rdfs:subClassOf :ArchaeologicalSite ;
                rdfs:comment "A specific geographical area where large stone monuments or constructions, like stones circles or standing stones, are located" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Menhir
:Menhir rdf:type owl:Class ;
        rdfs:subClassOf :MegalithicMonument ;
        rdfs:comment "A standing stone placed in the ground by humans" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#MiddleBronzeAge
:MiddleBronzeAge rdf:type owl:Class ;
                 rdfs:subClassOf :BronzeAge ;
                 rdfs:comment "The middle phase of the Bronze Age" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Municipality
:Municipality rdf:type owl:Class ;
              rdfs:subClassOf :E53_Place ;
              rdfs:comment "Second-level administrative division after district, with its own jurisdiction and local government" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Museum
:Museum rdf:type owl:Class ;
        rdfs:subClassOf :E74_Group ;
        rdfs:comment "A public entity whose efforts involve the acquisition, preservation, research and exhibition of objects with different types of values" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Narrative
:Narrative rdf:type owl:Class ;
           rdfs:subClassOf :E33_Linguistic_Object ;
           rdfs:comment "A story that transmits meaning and significant memories of a specific place" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#NaturalLandscape
:NaturalLandscape rdf:type owl:Class ;
                  rdfs:subClassOf :Landscape ;
                  rdfs:comment "A landscape containing features made by humans. It can be protected as a cultural heritage site" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#NaturalSoundscape
:NaturalSoundscape rdf:type owl:Class ;
                   rdfs:subClassOf :Soundscape ;
                   rdfs:comment "Sounds of nature in its characteristic environment" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Neolithic
:Neolithic rdf:type owl:Class ;
           rdfs:subClassOf :E4_Period ;
           rdfs:comment "A specific period from prehistory" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#OcupationOrUsage
:OcupationOrUsage rdf:type owl:Class ;
                  rdfs:subClassOf :E7_Activity ;
                  rdfs:comment "The occupation or usage of the archaeological site" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#OtherSounds
:OtherSounds rdf:type owl:Class ;
             rdfs:subClassOf :NaturalSoundscape ;
             rdfs:comment "Other sounds" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Parish
:Parish rdf:type owl:Class ;
        rdfs:subClassOf :E53_Place ;
        rdfs:comment "A minor administrative division, sub part of Municipalities" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#PlaqueIdol
:PlaqueIdol rdf:type owl:Class ;
            rdfs:subClassOf :Idol ;
            rdfs:comment "An idol in the shape of a plaque (engraved stone plaques)" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Region
:Region rdf:type owl:Class ;
        rdfs:subClassOf :E53_Place ;
        rdfs:comment "A geographical unit that can aggregate multiple districts" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Restoration
:Restoration rdf:type owl:Class ;
             rdfs:subClassOf :E7_Activity ;
             rdfs:comment "The restoration of components of the archaeological site" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#RuralLandscape
:RuralLandscape rdf:type owl:Class ;
                rdfs:subClassOf :CulturalLandscape ;
                rdfs:comment "Landscape charaterised by open fields, low population and green areas with diverse vegetation" .


###  http://www.semanticweb.org/int-act-project/8/mh-ontology-30#SoundsOfTheTreeBranches
:SoundsOfTheTreeBranches rdf:type owl:Class ;
                         rdfs:subClassOf :NaturalSoundscape ;
