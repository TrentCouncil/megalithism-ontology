<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#"
     xml:base="http://www.semanticweb.org/int-act-project/8/mh-ontology-30"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:mh-ontology-30="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30">
        <terms:creator>INT-ACT UÉvora Team</terms:creator>
        <terms:language>en</terms:language>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <terms:title>Megalithic Heritage Ontology</terms:title>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/language -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/language"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P129_is_about -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P129_is_about">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E89_Propositional_Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E1_CRM_Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P130_shows_features_of -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P130_shows_features_of">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E70_Thing"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E70_Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P14_carried_out_by -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P14_carried_out_by">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E7_Activity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E39_Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P165_incorporates -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P165_incorporates">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E89_Propositional_Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E90_Symbolic_Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P198_holds_or_supports -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P198_holds_or_supports">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E18_Physical_Thing"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E18_Physical_Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P46_is_composed_of -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P46_is_composed_of">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E18_Physical_Thing"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E18_Physical_Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P4_has_time_span -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P4_has_time_span">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E2_Temporal_Entity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E52_TimeSpan"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P53_has_former_or_current_location -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P53_has_former_or_current_location">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E18_Physical_Thing"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E53_Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P89_falls_within -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P89_falls_within">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E53_Place"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E53_Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P8_took_place_on_or_within -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P8_took_place_on_or_within">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E4_Period"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E18_Physical_Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasClimate -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasClimate">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P130_shows_features_of"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E53_Place"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Climate"/>
        <rdfs:comment>It specifies the type of climate present at a given site</rdfs:comment>
        <rdfs:label>has climate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasConstructionTimeSpan -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasConstructionTimeSpan">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P4_has_time_span"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Construction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E52_TimeSpan"/>
        <rdfs:label>It connects the construction of a site to its time span</rdfs:label>
        <rdfs:label>has construction time span</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasEngravings -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasEngravings">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P130_shows_features_of"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Menhir"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Engravings"/>
        <rdfs:comment>It relates the type of engraving a given Menhir has</rdfs:comment>
        <rdfs:label>has engravings</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasExcavationTimeSpan -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasExcavationTimeSpan">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P4_has_time_span"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Excavation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E52_TimeSpan"/>
        <rdfs:comment>Associates an excavation with the time span during which it took place</rdfs:comment>
        <rdfs:label>has excavation time span</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasIdentificationTimeSpan -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasIdentificationTimeSpan">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P4_has_time_span"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Identification"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E52_TimeSpan"/>
        <rdfs:comment>Indicates the time span in which a site was first identified</rdfs:comment>
        <rdfs:comment>has identification time span</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasMegalithicComponents -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasMegalithicComponents">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P46_is_composed_of"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#MegalithicMonument"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Menhir"/>
        <rdfs:comment>It relates each individual Menhir to the Cromlech</rdfs:comment>
        <rdfs:label>has megalithic components</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasTypicalLandscape -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasTypicalLandscape">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P130_shows_features_of"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E53_Place"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Landscape"/>
        <rdfs:label>Specifies the type of landscape of a site</rdfs:label>
        <rdfs:label>has typical landscape</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasUsageTimeSpan -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#hasUsageTimeSpan">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#P4_has_time_span"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#OcupationOrUsage"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E52_TimeSpan"/>
        <rdfs:comment>Specifies the time span during which a site was occupied or used</rdfs:comment>
        <rdfs:label>has usage time span</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Link -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Link">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E31_Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>The url of a digital object</rdfs:comment>
        <rdfs:label>Link</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#format -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#format">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#MegalithicMonument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The shape of the Megalithic Monument</rdfs:comment>
        <rdfs:label>format</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#heightMeters -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#heightMeters">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Menhir"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The height of a Menhir in meters</rdfs:comment>
        <rdfs:label>heightMeters</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#rockType -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#rockType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#MegalithicMonument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The type of rock from which the Megalithic Monument is made of</rdfs:comment>
        <rdfs:label>rockType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#usagetypeArtefacts -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#usagetypeArtefacts">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalArtefact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The type of usage of a archaeological artefact</rdfs:comment>
        <rdfs:label>usagetypeArtefacts</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#usagetypeMegalithism -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#usagetypeMegalithism">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#MegalithicSite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The usage type of a Megalithic Site</rdfs:comment>
        <rdfs:label>usagetypeMegalithism</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalArtefact -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalArtefact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E24_Physical_Human-Made_Thing"/>
        <rdfs:comment>Artefact found in an archaeological site</rdfs:comment>
        <rdfs:label>Archaeological Artefact</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalMonument -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalMonument">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#CulturalHeritageMonument"/>
        <rdfs:comment>A monument that preserves traces of human occupation</rdfs:comment>
        <rdfs:label>Archaeological Monument</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalSite -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalSite">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E27_Site"/>
        <rdfs:comment>The area where traces of human occupation have been found</rdfs:comment>
        <rdfs:label>Archaeological Site</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Archaeologist -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Archaeologist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E21_Person"/>
        <rdfs:comment>A professional whose expertise involves both on-site and off-site study of past human societies</rdfs:comment>
        <rdfs:label>Archaeologist</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Arrowhead -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Arrowhead">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalArtefact"/>
        <rdfs:comment>The tip of an arrow</rdfs:comment>
        <rdfs:label>Arrowhead</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Audio -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Audio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E31_Document"/>
        <rdfs:comment>Audio files</rdfs:comment>
        <rdfs:label>Audio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Beaker -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Beaker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#ArchaeologicalArtefact"/>
        <rdfs:comment>A ceramic drinking or storage vessel typical of Late Neolithic/Bronze Age</rdfs:comment>
        <rdfs:label>Beaker</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#BirdSounds -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#BirdSounds">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#NaturalSoundscape"/>
        <rdfs:comment>Sounds of birds chirping</rdfs:comment>
        <rdfs:label>Bird Sounds</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#BronzeAge -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#BronzeAge">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E4_Period"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Neolithic"/>
        <rdfs:comment>A specific and transitional period between prehistory and protohistory</rdfs:comment>
        <rdfs:label>Bronze Age</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Climate -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Climate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E26_Physical_Feature"/>
        <rdfs:comment>A feature regarding weather conditions</rdfs:comment>
        <rdfs:label>Climate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Construction -->


    <owl:Class rdf:about="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Construction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/int-act-project/8/mh-ontology-30#E7_Activity"/>
        <rdfs:comment>The construction of the archaeological site</rdfs:comment>
        <rdfs:label>Construction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/int-act-project/8/mh-ontology-30#Coordinates -->


